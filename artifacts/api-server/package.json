{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/auth/crypto.test.ts src/auth/entitlement.test.ts src/auth/middleware.test.ts src/security/requestSecurity.test.ts src/security/legacyRoleplay.test.ts src/security/tenantRoleplay.test.ts src/knowledge/spartanCorpus.test.ts"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.21.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/branch-engine": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/hospice-sales-runtime": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "multer": "^2.2.0",
    "openai": "^6.48.0",
    "p-limit": "^7.3.0",
    "p-retry": "^8.0.0",
    "pdfkit": "^0.19.1",
    "pg": "^8.22.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "resend": "^6.17.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "catalog:",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.20.0",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0",
    "tsx": "^4.23.0",
    "vitest": "^4.1.10"
  }
}
