# EAS reads this file from the app root. Keep release archives limited to
# source required by the mobile app and its workspace dependencies.

# Dependencies are installed from the lockfile on EAS.
**/node_modules/

# Repository and local tool state.
.git/
.agents/
.grok/
.cursor/
.vscode/
.idea/
.cache/
.local/
.expo/
.metro-cache/

# Large media and design sources are not native build inputs.
attached_assets/
*.mp4
*.mov
*.webm
SpartanCoaching-*.mp4
design-system/

# Other applications in the monorepo.
artifacts/spartan-coaching/
artifacts/api-server/
artifacts/spartan-video/
artifacts/mockup-sandbox/

# Generated output, documentation, and tests.
**/dist/
!lib/hospice-sales-runtime/dist/
!lib/hospice-sales-runtime/dist/**
docs/
**/__tests__/
**/*.test.ts
**/*.test.tsx
**/*.tsbuildinfo
coverage/
tmp/
out-tsc/

# Local environment files and Replit artifacts.
.env
.env.*
!.env.example
.replit
.replitignore
**/.replit-artifact/
