{
  "cli": {
    "version": ">= 21.0.2",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      }
    },
    "testflight": {
      "distribution": "store",
      "autoIncrement": true,
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://spartanhospicecoaching.com",
        "EXPO_PUBLIC_DOMAIN": "spartanhospicecoaching.com"
      },
      "ios": {
        "buildConfiguration": "Release",
        "credentialsSource": "remote",
        "image": "latest"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://spartanhospicecoaching.com",
        "EXPO_PUBLIC_DOMAIN": "spartanhospicecoaching.com"
      },
      "ios": {
        "buildConfiguration": "Release",
        "credentialsSource": "remote",
        "image": "latest"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "nick.lynch5413@gmail.com",
        "ascAppId": "6795266551",
        "appleTeamId": "65C25YHCX9"
      }
    }
  }
}
