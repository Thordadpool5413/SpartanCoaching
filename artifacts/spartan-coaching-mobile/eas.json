{
  "cli": {
    "version": ">= 21.0.2",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://spartanhospicecoaching.com",
        "EXPO_PUBLIC_DOMAIN": "spartanhospicecoaching.com",
        "EAS_SKIP_ASSOCIATED_DOMAINS": "1"
      },
      "ios": {
        "simulator": false
      }
    },
    "testflight": {
      "distribution": "store",
      "autoIncrement": true,
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://spartanhospicecoaching.com",
        "EXPO_PUBLIC_DOMAIN": "spartanhospicecoaching.com",
        "EAS_SKIP_ASSOCIATED_DOMAINS": "1"
      },
      "ios": {
        "buildConfiguration": "Release",
        "credentialsSource": "remote"
      }
    },
    "testflight-applinks": {
      "extends": "testflight",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://spartanhospicecoaching.com",
        "EXPO_PUBLIC_DOMAIN": "spartanhospicecoaching.com",
        "EAS_SKIP_ASSOCIATED_DOMAINS": "0"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://spartanhospicecoaching.com",
        "EXPO_PUBLIC_DOMAIN": "spartanhospicecoaching.com",
        "EAS_SKIP_ASSOCIATED_DOMAINS": "1"
      },
      "ios": {
        "buildConfiguration": "Release",
        "credentialsSource": "remote"
      }
    },
    "production-applinks": {
      "extends": "production",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://spartanhospicecoaching.com",
        "EXPO_PUBLIC_DOMAIN": "spartanhospicecoaching.com",
        "EAS_SKIP_ASSOCIATED_DOMAINS": "0"
      }
    }
  },
  "submit": {
    "testflight": {
      "ios": {
        "ascAppId": "6795266551"
      }
    }
  }
}
