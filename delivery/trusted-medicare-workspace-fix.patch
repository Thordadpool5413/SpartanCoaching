}/></Field><Field label='Territory owner'><input value={form.owner} onChange={(event) => setForm({...form,owner:event.target.value})}/></Field><Field label='Relationship context'><select value={form.relationshipContext} onChange={(event) => setForm({...form,relationshipContext:event.target.value})}><option>Unknown</option><option>Open</option><option>Existing</option><option>Restricted</option></select></Field><label className='field wide'><span>Operating note · no patient PHI</span><textarea value={form.note} onChange={(event) => setForm({...form,note:event.target.value})}/></label></div><div className='row-actions'><button className='primary' onClick={() => void saveTruth()} disabled={saving}><Save size={14}/>{saving ? 'Saving...' : 'Save internal evidence'}</button>{selectedMarket?.operationalTruth && <button onClick={() => void deleteTruth()} disabled={saving}><Trash2 size={14}/>Clear evidence</button>}</div><details className='history-panel'><summary><History size={14}/>Operating evidence history <span>{history.length} changes</span></summary><div>{history.slice(0,10).map((row) => <article key={row.id}><b>{row.action} · {(row.changedFields || []).join(', ')}</b><small>{new Date(row.createdAt).toLocaleString()}</small></article>)}{!history.length && <p>No stored changes for this territory yet.</p>}</div></details></> : <p className='empty'>Select a county before entering internal operating evidence.</p>}</div>
+    </div>
