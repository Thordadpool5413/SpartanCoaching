+  </section>;
+}
+
+function Field({ label, children }: { label: string; children: React.ReactNode }) { return <label className='field'><span>{label}</span>{children}</label>; }
+function Tri({ label, value, onChange }: { label: string; value: string; onChange: (value: string) => void }) { return <Field label={label}><select value={value} onChange={(event) => onChange(event.target.value)}><option>Unknown</option><option>Yes</option><option>No</option></select></Field>; }
