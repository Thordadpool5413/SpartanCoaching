+export async function createChangeAlerts(providerCcn:string,providerLabel:string,state:string,changes:SnapshotChange[],watchers:Watcher[]){if(!changes.length||!watchers.length)return{created:0,pushSent:0};const{severity,summary}=summarizeChanges(changes),unique=[...new Map(watchers.map(w=>[w.userId,w])).values()],createdAt=new Date().toISOString();let created=0;for(const watcher of unique){const[id]=await db.add(table(watcher.userId),[{providerCcn,providerLabel:providerLabel||watcher.label||providerCcn,state:state||watcher.state||'',createdAt,severity,summary,changes:changes.slice(0,12),readAt:null} satisfies AlertRecord]);if(id)created++;}let pushSent=0;try{const result=await notifications.send({userIds:unique.map(w=>w.userId),notification:{title:`${providerLabel||providerCcn} changed`,body:summary},data:{kind:'provider-change',ccn:providerCcn,state:state||'',severity},ttlSeconds:86400});pushSent=result.sent;}catch(e){console.warn('provider_change_push_failed',providerCcn,e instanceof Error?e.message:String(e));}return{created,pushSent};}
