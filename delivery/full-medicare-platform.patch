+export type SnapshotChange={key:string;label:string;from:unknown;to:unknown;delta:number|null;percentDelta:number|null;severity:ChangeSeverity};
+type SnapshotLike={metrics:Record<string,unknown>};
+const numericSpecs=[['adc','Estimated Medicare ADC'],['beneficiaries','Medicare beneficiaries'],['payment','Medicare payment'],['serviceZipCount','Patient-service ZIPs'],['countyFootprint','County/equivalent footprint'],['mappingCoveragePct','Service-geography mapping coverage'],['cahpsStar','CAHPS summary star'],['recommendPct','Definitely recommend'],['timelyHelpPct','Timely help'],['hci','Hospice Care Index'],['ssvi2025','SSVI FY2025'],['topThreatScore','Top competitor threat score'],['topThreatSharedZips','Top competitor shared ZIPs'],['relatedEnrollments','Related enrollments']] as const;
+const stringSpecs=[['legalName','Legal organization'],['topThreatCcn','Top collision competitor'],['hcrisFiscalEnd','HCRIS fiscal year end']] as const;
+export function compareSnapshots(previous:SnapshotLike|null,current:SnapshotLike){if(!previous)return[] as SnapshotChange[];const out:SnapshotChange[]=[];for(const [key,label] of numericSpecs){const a=previous.metrics[key],b=current.metrics[key];if(typeof a!=='number'||typeof b!=='number'||!Number.isFinite(a)||!Number.isFinite(b)||a===b)continue;const delta=b-a,pct=a!==0?delta/Math.abs(a)*100:null,mag=Math.abs(pct??delta),severity:ChangeSeverity=mag>=15?'high':mag>=5?'medium':'low';out.push({key,label,from:a,to:b,delta,percentDelta:pct,severity});}for(const [key,label] of stringSpecs){const a=String(previous.metrics[key]??''),b=String(current.metrics[key]??'');if(a!==b&&(a||b))out.push({key,label,from:a||'Not reported',to:b||'Not reported',delta:null,percentDelta:null,severity:'high'});}return out;}
+export function summarizeChanges(changes:SnapshotChange[]){const rank:Record<ChangeSeverity,number>={low:1,medium:2,high:3},ordered=[...changes].sort((a,b)=>rank[b.severity]-rank[a.severity]),severity=ordered.reduce<ChangeSeverity>((best,c)=>rank[c.severity]>rank[best]?c.severity:best,'low'),summary=ordered.slice(0,3).map(c=>c.percentDelta===null||c.percentDelta===undefined?`${c.label} changed`:`${c.label} ${c.percentDelta>0?'+':''}${c.percentDelta.toFixed(1)}%`).join(' · ');return{severity,summary:summary||'Provider intelligence changed'};}
