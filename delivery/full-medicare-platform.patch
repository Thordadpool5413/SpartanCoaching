+const checkpointPath='monitoring/checkpoint.json',pendingPrefix='monitoring/pending-alerts/';const statusPath=(ccn:string)=>`monitoring/status/${ccn}.json`,pendingPath=(ccn:string)=>`${pendingPrefix}${ccn}-${Date.now()}.json`;
+async function writeStatus(ccn:string,status:Record<string,unknown>){const[ok]=await storage.write([{path:statusPath(ccn),content:JSON.stringify({ccn,...status}),contentType:'application/json'}]);if(!ok)console.warn('monitor_status_write_failed',ccn);}
