+export type WeightedPart={name:string;value:number|null;weight:number};
+const finite=(v:unknown):v is number=>typeof v==='number'&&Number.isFinite(v);
+const clamp=(v:number,min=0,max=100)=>Math.max(min,Math.min(max,v));
+export function weightedAvailable(parts:WeightedPart[],totalWeight=parts.reduce((a,p)=>a+p.weight,0)){const available=parts.filter(p=>finite(p.value)&&p.weight>0),availableWeight=available.reduce((a,p)=>a+p.weight,0),score=availableWeight?Math.round(available.reduce((a,p)=>a+(p.value as number)*p.weight,0)/availableWeight):null,coveragePct=totalWeight>0?Math.round(availableWeight/totalWeight*1000)/10:0,rankingScore=score===null?null:Math.round(score*coveragePct/100);return{score,rankingScore,coveragePct,availableWeight,totalWeight,parts};}
+export function reportedSum(values:Array<number|null|undefined>){const xs=values.filter(finite),total=values.length;return{value:xs.length?xs.reduce((a,b)=>a+b,0):null,reported:xs.length,total,coveragePct:total?Math.round(xs.length/total*1000)/10:0};}
+export function buildSnfOpportunity(residents:number|null,beds:number|null){const parts:WeightedPart[]=[{name:'Resident census',value:residents===null?null:clamp(residents/180*100),weight:68},{name:'Certified beds',value:beds===null?null:clamp(beds/220*100),weight:32}],result=weightedAvailable(parts,100);return{...result,method:'Resident census 68% + certified beds 32%; evidence-normalized signal is confidence-adjusted by reported-input coverage for ranking.'};}
