{
  "name": "workspace",
  "version": "0.0.0",
  "packageManager": "pnpm@10.26.1",
  "license": "MIT",
  "scripts": {
    "preinstall": "node scripts/require-pnpm.mjs",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "smoke:api": "node scripts/smoke-built-api.mjs",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "test:web": "pnpm --filter @workspace/spartan-coaching test",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "budget": "node scripts/performance-budget.mjs",
    "smoke:health": "node scripts/smoke-health.mjs",
    "smoke:parity": "node scripts/smoke-parity.mjs",
    "smoke:parity:auth": "node scripts/smoke-parity-auth.mjs",
    "ship:check": "node scripts/ship-check.mjs",
    "test:delivery": "pnpm --filter @workspace/field-kit-catalog test && pnpm --filter @workspace/api-server exec vitest run src/delivery/featureFlags.test.ts src/routes/health.test.ts",
    "ci:delivery": "pnpm run test:delivery",
    "ops:backup-drill": "pnpm --filter @workspace/db run backup-restore-drill",
    "test:ops": "pnpm --filter @workspace/db exec vitest run src/ops-readiness.test.ts",
    "release-gate": "node scripts/release-gate.mjs",
    "release-gate:live": "node scripts/release-gate.mjs --live-only",
    "test:release-gate": "pnpm --filter @workspace/field-kit-catalog exec vitest run src/release-gate.test.ts",
    "db:migrate": "pnpm --filter @workspace/db run migrate",
    "db:push": "pnpm --filter @workspace/db run push",
    "verify:ios:qa": "bash scripts/verify-testflight.sh preview",
    "verify:ios:production": "bash scripts/verify-testflight.sh production-applinks",
    "verify:ios:testflight": "bash scripts/verify-testflight.sh testflight"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@types/node": "catalog:",
    "prettier": "^3.9.5",
    "typescript": "~5.9.3",
    "vitest": "^4.1.10"
  }
}
