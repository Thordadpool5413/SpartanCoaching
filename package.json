{
  "name": "workspace",
  "version": "0.0.0",
  "packageManager": "pnpm@10.26.1",
  "license": "MIT",
  "scripts": {
    "preinstall": "node scripts/require-pnpm.mjs",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "smoke:api": "node scripts/smoke-built-api.mjs",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "test:web": "pnpm --filter @workspace/spartan-coaching test",
    "budget": "node scripts/performance-budget.mjs",
    "smoke:health": "node scripts/smoke-health.mjs",
    "smoke:parity": "node scripts/smoke-parity.mjs",
    "smoke:parity:auth": "node scripts/smoke-parity-auth.mjs",
    "ship:check": "node scripts/ship-check.mjs",
    "env:preflight": "pnpm --filter @workspace/env-config run preflight"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "prettier": "^3.9.5",
    "typescript": "~5.9.3",
    "vitest": "^4.1.10"
  }
}

