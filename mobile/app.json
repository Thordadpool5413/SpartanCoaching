{
  "expo": {
    "name": "Spartan Coaching",
    "slug": "spartan-coaching",
    "version": "1.0.0",
    "icon": "./hospice-logo-240.png",
    "orientation": "portrait",
    "scheme": "spartancoaching",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nickl.spartancoaching"
    },
    "android": {
      "package": "com.nickl.spartancoaching",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./hospice-logo-240.png",
        "backgroundColor": "#07111E"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
