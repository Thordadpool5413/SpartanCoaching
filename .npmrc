# Keep pnpm store/tmp outside the git workspace so Metro never watches ephemeral
# dirs like <workspace>/.local/share/pnpm/_tmp_* (Replit ENOENT crash).
store-dir=/tmp/pnpm-store
cache-dir=/tmp/pnpm-cache
state-dir=/tmp/pnpm-state

# Metro / babel-preset-expo / react-native-worklets require these to resolve
# from plugin loaders (not only nested under @babel/core). Prevents Replit
# publish failures: Cannot find module '@babel/types'.
public-hoist-pattern[]=*@babel/*
public-hoist-pattern[]=*@expo/config*
